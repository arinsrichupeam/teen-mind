// MySQL DATETIME ไม่มี TZ — เก็บ/ตีความเป็น UTC ที่แอป
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
  UNSPECIFIED
}

enum CaseStatus {
  PENDING
  IN_PROGRESS
  TRANSFER_PENDING // รอปลายทางยืนยันรับ / ปฏิเสธ
  CLOSED
}

enum CaseTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FacilityStatus {
  INACTIVE
  ACTIVE
}

enum AdminStatus {
  PENDING
  APPROVED
  DISABLED
}

// คนละชุดกับ Case.result (ผลคัดกรอง) — ความเสี่ยงตามนักจิตบน TreatmentNote
// NONE = ประเมินแล้วไม่เสี่ยง; null = ไม่ประเมิน (คนละความหมาย)
enum PsychRisk {
  NONE
  LOW
  MODERATE
  HIGH
}

// ผลคัดกรองสรุปล่าสุดของ Case (analytics / filter)
enum ScreeningResult {
  NEGATIVE
  POSITIVE_LOW
  POSITIVE_MODERATE
  POSITIVE_HIGH
  POSITIVE_SEVERE // Red — distinct from Orange (POSITIVE_HIGH); see ADR 0002
  INCOMPLETE
}

// ชุดแบบประเมินของเคส — ตั้งตอนสร้าง ไม่เปลี่ยนกลางทาง
enum AssessmentPackage {
  BURNOUT // MBI-GS
  DEPRESSION // 2Q → (9Q/8Q) → Problem
  FULL // MBI-GS → depression path
}

// write actions เท่านั้น — ไม่ log VIEW; อ่านได้เฉพาะ central admin (บังคับที่แอป)
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGE
  STATUS_CHANGE
}

enum AuditActorType {
  USER
  ADMIN
  VOLUNTEER
  SYSTEM
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

// Auth (แอป enforce) — ThaiD เป็นทางเลือกเท่ากันทั้งสองฝั่ง:
//   Profile      — สมัคร/login: Line | ThaiD (Account.provider); ThaiD → prefill Profile
//   ProfileAdmin  — สมัคร/login: ThaiD | username/password; ThaiD → prefill ProfileAdmin (citizenId = pid)
// passwordHash optional สำหรับ Profile; admin ที่เลือก password ต้องมี username+hash (บังคับที่แอป)
model User {
  id                 String         @id @default(cuid())
  name               String?
  username           String?        @unique @db.VarChar(100)
  passwordHash       String?        @db.VarChar(255) // argon2id / bcrypt only — never plaintext
  mustChangePassword Boolean        @default(false)
  email              String?        @unique
  emailVerified      DateTime?
  image              String?        @db.Text
  accounts           Account[]
  sessions           Session[]
  profile            Profile?
  profileAdmins      ProfileAdmin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// OAuth/OIDC link — provider เช่น "line" | "thaid"; providerAccountId = OIDC sub (ไม่ใช้ pid)
// ThaiD: เทียบ pid ↔ Profile.citizenId / ProfileAdmin.citizenId ที่แอปเมื่อสมัครหรือ link
model Account {
  id                    String  @id @default(cuid())
  userId                String // 1 user → N providers (NextAuth/Auth.js)
  type                  String
  provider              String
  providerAccountId     String
  refreshToken          String? @db.Text
  accessToken           String? @db.Text
  expiresAt             Int?
  tokenType             String?
  scope                 String?
  idToken               String? @db.Text
  sessionState          String?
  refreshTokenExpiresIn Int?
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Prefix {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)

  profiles      Profile[]
  profileAdmins ProfileAdmin[]
  volunteers    Volunteer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id String @id @default(cuid())
  // auth delete ต้องไม่ลบ clinical graph — SetNull แล้ว soft-disable User
  userId String? @unique
  // PII: encrypt at rest (KMS / column encrypt); format 13 หลักบังคับที่แอป
  citizenId   String   @unique @db.VarChar(13)
  prefixId    Int
  sex         Sex
  firstName   String   @db.VarChar(100)
  lastName    String   @db.VarChar(100)
  birthDate   DateTime
  ethnicity   String   @db.VarChar(50)
  nationality String   @db.VarChar(50)
  phone       String   @db.VarChar(20)
  hn          String?  @db.VarChar(50)

  addresses         Address[]
  emergencyContacts EmergencyContact[]
  cases             Case[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prefix             Prefix              @relation(fields: [prefixId], references: [id], onDelete: Restrict)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  school             School?             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  healthcareFacility HealthcareFacility? @relation(fields: [healthcareFacilityId], references: [id], onDelete: Restrict)

  schoolId             Int?
  gradeYear            Int?
  // หน่วยงานที่ผู้ใช้เลือกต้องการรักษา (ตอนสมัคร)
  healthcareFacilityId String?

  @@index([prefixId])
  @@index([schoolId])
  @@index([healthcareFacilityId])
}

// สมัคร/login: ThaiD (ทางเลือก) | username/password — ดู User comment
model ProfileAdmin {
  id                   String              @id @default(cuid())
  userId               String
  // PII: encrypt at rest (KMS / column encrypt); format 13 หลักบังคับที่แอป; ถ้าใช้ ThaiD ต้องตรง pid
  citizenId            String              @unique @db.VarChar(13)
  prefixId             Int
  firstName            String              @db.VarChar(100)
  lastName             String              @db.VarChar(100)
  phone                String?             @db.VarChar(20)
  affiliationId        Int
  employeeTypeId       Int
  profession           String?             @db.VarChar(100)
  license              String?             @db.VarChar(50)
  status               AdminStatus         @default(PENDING)
  receiveAlert         Boolean             @default(false)
  roleId               Int // require explicit role — ไม่ใช้ magic default
  // หน่วยงาน = HealthcareFacility (ไม่เก็บชื่อซ้ำเป็น free-text)
  // required — กัน MySQL UNIQUE+NULL ที่อนุญาตหลายแถว facility=null ต่อ user
  healthcareFacilityId String
  prefix               Prefix             @relation(fields: [prefixId], references: [id], onDelete: Restrict)
  role                 Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliation          Affiliation        @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  employeeType         EmployeeType       @relation(fields: [employeeTypeId], references: [id], onDelete: Restrict)
  healthcareFacility   HealthcareFacility @relation(fields: [healthcareFacilityId], references: [id], onDelete: Restrict)
  treatmentNotes       TreatmentNote[]
  assignedCases        Case[]             @relation("CaseAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, healthcareFacilityId])
  @@index([userId])
  @@index([prefixId])
  @@index([healthcareFacilityId, status])
  @@index([status, createdAt])
  @@index([affiliationId])
  @@index([employeeTypeId])
  @@index([roleId])
}

model Address {
  id        String  @id @default(cuid())
  profileId String
  houseNo   String  @db.VarChar(50)
  villageNo String? @db.VarChar(50)
  soi       String? @db.VarChar(100)
  road      String? @db.VarChar(100)
  postalCode String? @db.VarChar(5)
  // App invariant (validateGeoHierarchy): district.provinceId == provinceId
  //                                      subdistrict.districtId == districtId
  // denorm IDs ไว้ filter — MySQL ไม่ enforce composite hierarchy FK
  provinceId    Int
  districtId    Int
  subdistrictId Int

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  province    Province    @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district    District    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  subdistrict Subdistrict @relation(fields: [subdistrictId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([provinceId])
  @@index([districtId])
  @@index([subdistrictId])
}

model Role {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(50) // e.g. SUPERADMIN, ADMIN, STAFF
  name          String         @unique @db.VarChar(100)
  profileAdmins ProfileAdmin[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmergencyContact {
  id        String  @id @default(cuid())
  profileId String
  name      String  @db.VarChar(100)
  phone     String  @db.VarChar(20)
  relation  String  @db.VarChar(50)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model Province {
  id         Int                  @id
  code       Int                  @unique
  nameInThai String               @db.VarChar(150)
  districts  District[]
  addresses  Address[]
  facilities HealthcareFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model District {
  id           Int                  @id
  code         Int                  @unique
  nameInThai   String               @db.VarChar(150)
  provinceId   Int
  zoneId       Int?
  subdistricts Subdistrict[]
  province     Province             @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  zone         Zone?                @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  addresses    Address[]
  schools      School[]
  facilities   HealthcareFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([zoneId])
  @@index([provinceId])
}

model Subdistrict {
  id         Int                  @id
  code       Int                  @unique
  nameInThai String               @db.VarChar(150)
  districtId Int
  district   District             @relation(fields: [districtId], references: [id], onDelete: Restrict)
  addresses  Address[]
  facilities HealthcareFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}

// Multi-round ใต้เคสเดียว (round ร่วม TreatmentNote + แบบประเมิน); result = สรุปล่าสุด; หลัง CLOSED → Case ใหม่
// status: PENDING (รอผู้ดูแลรับ) → IN_PROGRESS → CLOSED; ส่งต่อ = TRANSFER_PENDING
// healthcareFacilityId = หน่วยงาน; assigneeAdminId = นักจิตผู้รับ (ว่างได้ตอน PENDING)
// รับส่งต่อแล้ว → PENDING ที่ปลายทาง (มีหน่วยงาน ไม่มี assignee) จน claim
// transferToFacilityId = รอปลายทางยืนยันรับ/ปฏิเสธ
model Case {
  id                   String          @id @default(cuid())
  profileId            String
  healthcareFacilityId String?
  assigneeAdminId      String?
  transferToFacilityId String?
  transferNote         String?         @db.Text
  transferRequestedAt  DateTime?
  volunteerId          Int?
  schoolScreeningId    Int?
  latitude             Decimal?        @db.Decimal(10, 7)
  longitude            Decimal?        @db.Decimal(10, 7)
  package              AssessmentPackage @default(FULL)
  result               ScreeningResult
  closeCaseReason      String?         @db.Text
  status               CaseStatus      @default(PENDING)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  treatmentNotes     TreatmentNote[]
  questions2Q        Question2Q[]
  questionsPhqa      QuestionPhqa[]
  questionsPhqaAddon QuestionPhqaAddon[]
  questions9Q        Question9Q[]
  questions8Q        Question8Q[]
  questionsMbiGs     QuestionMbiGs[]
  questionsProblem   QuestionProblem[]
  volunteer          Volunteer?          @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  schoolScreening    SchoolScreening?    @relation(fields: [schoolScreeningId], references: [id], onDelete: SetNull)
  healthcareFacility HealthcareFacility? @relation("CaseOwner", fields: [healthcareFacilityId], references: [id], onDelete: Restrict)
  transferToFacility HealthcareFacility? @relation("CaseTransferPending", fields: [transferToFacilityId], references: [id], onDelete: Restrict)
  assigneeAdmin      ProfileAdmin?       @relation("CaseAssignee", fields: [assigneeAdminId], references: [id], onDelete: SetNull)
  transfers          CaseTransfer[]

  // Restrict — ลบ Profile ต้องไม่ cascade ลบประวัติคลินิก (notes / questionnaire ยัง Cascade จาก Case)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@index([profileId, status, createdAt])
  @@index([healthcareFacilityId, status])
  @@index([transferToFacilityId, status])
  @@index([assigneeAdminId, status])
  @@index([status, updatedAt])
  @@index([result, status])
  @@index([volunteerId])
  @@index([schoolScreeningId])
}

// ประวัติส่งต่อเคส (ขอ → รับ/ปฏิเสธ); Case.transferTo* = คำขอค้างปัจจุบันเท่านั้น
model CaseTransfer {
  id             String             @id @default(cuid())
  caseId         String
  fromFacilityId String?
  toFacilityId   String
  status         CaseTransferStatus @default(PENDING)
  requestNote    String?            @db.Text
  responseNote   String?            @db.Text
  requestedAt    DateTime           @default(now())
  respondedAt    DateTime?

  case         Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromFacility HealthcareFacility? @relation("TransferFrom", fields: [fromFacilityId], references: [id], onDelete: Restrict)
  toFacility   HealthcareFacility  @relation("TransferTo", fields: [toFacilityId], references: [id], onDelete: Restrict)

  @@index([caseId, requestedAt])
  @@index([toFacilityId, status, requestedAt])
  @@index([fromFacilityId, status, requestedAt])
  @@index([status, requestedAt])
}

model TreatmentNote {
  id            String  @id @default(cuid())
  caseId        String
  round         Int
  authorAdminId String?
  authorAdmin   ProfileAdmin? @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  consult         String?   @db.VarChar(100)
  scheduleTelemed DateTime?
  unreachable     Boolean   @default(false)

  subjective String? @db.Text
  objective  String? @db.Text
  assessment String? @db.Text
  plan       String? @db.Text
  note       String? @db.Text
  psychRisk  PsychRisk? // optional — นัดที่ไม่ประเมินคลินิกเว้นว่างได้

  followUp DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, round])
  @@index([authorAdminId])
}

// คะแนน/flag: bounds บังคับที่แอป (validateQuestionnaireScores); MySQL CHECK เพิ่มใน migration ถ้าต้องการ
model QuestionProblem {
  id     String @id @default(cuid())
  caseId String
  round  Int

  familyRelation      Int @default(0)
  familyStudyPressure Int @default(0)
  familyConflict      Int @default(0)
  familyAbuse         Int @default(0)
  familyLoss          Int @default(0)

  socialFriendIssue Int @default(0)
  socialBullying    Int @default(0)
  socialBreakup     Int @default(0)
  socialTeacher     Int @default(0)
  socialAssault     Int @default(0)

  studyStress       Int @default(0)
  studyNoMotivation Int @default(0)
  studyBurnout      Int @default(0)
  studyTimeManage   Int @default(0)
  studyHomeworkLoad Int @default(0)
  studyExamAnxiety  Int @default(0)

  financeFamilyIssue Int @default(0)

  lifestyleSocialMediaOveruse Int @default(0)
  lifestyleGamingAddiction    Int @default(0)
  lifestyleSubstanceUse       Int @default(0)
  lifestyleEatingIssue        Int @default(0)
  lifestyleBodyImageConcern   Int @default(0)
  lifestyleInsomnia           Int @default(0)

  sum Int @default(0)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, round])
}

model Question2Q {
  id     String @id @default(cuid())
  caseId String
  round  Int
  q1     Int // 0–1 (app + CHECK)
  q2     Int // 0–1

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, round])
}

model QuestionPhqa {
  id     String @id @default(cuid())
  caseId String
  round  Int
  q1     Int // 0–3
  q2     Int
  q3     Int
  q4     Int
  q5     Int
  q6     Int
  q7     Int
  q8     Int
  q9     Int
  sum    Int

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, round])
}

model QuestionPhqaAddon {
  id     String @id @default(cuid())
  caseId String
  round  Int
  q1     Int // 0–1
  q2     Int // 0–1

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, round])
}

model Question9Q {
  id     String @id @default(cuid())
  caseId String
  round  Int
  q1     Int    @default(0) // 0–3
  q2     Int    @default(0)
  q3     Int    @default(0)
  q4     Int    @default(0)
  q5     Int    @default(0)
  q6     Int    @default(0)
  q7     Int    @default(0)
  q8     Int    @default(0)
  q9     Int    @default(0)
  sum    Int    @default(0)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, round])
}

model Question8Q {
  id      String @id @default(cuid())
  caseId  String
  round   Int
  q1      Int    @default(0) // 0–3
  q2      Int    @default(0)
  q3      Int    @default(0)
  q4      Int    @default(0)
  q5      Int    @default(0)
  q6      Int    @default(0)
  q7      Int    @default(0)
  q8      Int    @default(0)
  q8Addon Int    @default(0) // follow-up เมื่อตอบข้อคิดฆ่าตัวตาย
  sum     Int    @default(0)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, round])
}

// MBI-GS: เก็บคำตอบ + คะแนนย่อยเท่านั้น — ไม่เก็บข้อคำถาม (ลิขสิทธิ์ Mind Garden)
// q1–q16 เรียงตามแบบที่ได้สิทธิ์; map → มิติ ทำที่แอปตาม scoring key ในคู่มือ
// ไม่มี sum รวม — แปลผลแยก 3 มิติ (exhaustion / cynicism / professionalEfficacy)
model QuestionMbiGs {
  id     String @id @default(cuid())
  caseId String
  round  Int

  q1  Int @default(0) // 0–6 frequency
  q2  Int @default(0)
  q3  Int @default(0)
  q4  Int @default(0)
  q5  Int @default(0)
  q6  Int @default(0)
  q7  Int @default(0)
  q8  Int @default(0)
  q9  Int @default(0)
  q10 Int @default(0)
  q11 Int @default(0)
  q12 Int @default(0)
  q13 Int @default(0)
  q14 Int @default(0)
  q15 Int @default(0)
  q16 Int @default(0)

  // subscale sums (แอปคำนวณจาก item map ในคู่มือ); mean = sum / nItems
  exhaustion           Int @default(0) // 5 items → 0–30
  cynicism             Int @default(0) // 5 items → 0–30
  professionalEfficacy Int @default(0) // 6 items → 0–36

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, round])
}

model School {
  id            Int               @id @default(autoincrement())
  name          String            @db.VarChar(200)
  districtId    Int
  status        Boolean           @default(true) // active/inactive only
  screeningDate DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  profiles      Profile[]
  screenings    SchoolScreening[]
  district      District          @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@index([districtId])
}

// โรงพยาบาล / ศูนย์บริการสาธารณสุข (= หน่วยงาน)
model HealthcareFacility {
  id            String         @id @default(cuid())
  name          String         @db.VarChar(200)
  address       String?        @db.Text
  // App invariant (validateGeoHierarchy): same as Address
  provinceId    Int
  districtId    Int
  subdistrictId Int
  latitude      Decimal?       @db.Decimal(10, 7)
  longitude     Decimal?       @db.Decimal(10, 7)
  affiliationId Int
  zoneId        Int? // null = ยังไม่จัดเข้า zone
  status        FacilityStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  province           Province      @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  district           District      @relation(fields: [districtId], references: [id], onDelete: Restrict)
  subdistrict        Subdistrict   @relation(fields: [subdistrictId], references: [id], onDelete: Restrict)
  affiliation        Affiliation   @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  zone               Zone?         @relation("ZoneMembers", fields: [zoneId], references: [id], onDelete: SetNull)
  facilitatedZones   Zone[]        @relation("ZoneFacilitator")
  units              FacilityUnit[]

  profiles           Profile[]
  profileAdmins      ProfileAdmin[]
  volunteers         Volunteer[]
  cases              Case[]         @relation("CaseOwner")
  incomingTransfers  Case[]         @relation("CaseTransferPending")
  transfersFrom      CaseTransfer[] @relation("TransferFrom")
  transfersTo        CaseTransfer[] @relation("TransferTo")

  @@index([provinceId])
  @@index([districtId])
  @@index([subdistrictId])
  @@index([affiliationId])
  @@index([zoneId])
  @@index([status])
}

// เขต / โซน — แม่ zone = facilitatorFacilityId (1 ต่อ zone)
model Zone {
  id                    Int                 @id @default(autoincrement())
  name                  String              @unique @db.VarChar(100)
  status                Boolean             @default(true)
  facilitatorFacilityId String?             @unique
  facilitatorFacility   HealthcareFacility? @relation("ZoneFacilitator", fields: [facilitatorFacilityId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  districts  District[]
  facilities HealthcareFacility[] @relation("ZoneMembers")
}

// หน่วยงานย่อย ของโรงพยาบาล / ศบส.
model FacilityUnit {
  id                   Int      @id @default(autoincrement())
  name                 String   @db.VarChar(200)
  healthcareFacilityId String
  status               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  healthcareFacility HealthcareFacility @relation(fields: [healthcareFacilityId], references: [id], onDelete: Cascade)

  @@unique([healthcareFacilityId, name])
  @@index([healthcareFacilityId])
}

model SchoolScreening {
  id        Int       @id @default(autoincrement())
  schoolId  Int
  round     Int
  startDate DateTime
  endDate   DateTime?
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cases     Case[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, round])
}

model Volunteer {
  id                   Int                @id @default(autoincrement())
  // PII: encrypt at rest (KMS / column encrypt); format 13 หลักบังคับที่แอป
  citizenId            String             @unique @db.VarChar(13)
  prefixId             Int
  firstName            String             @db.VarChar(100)
  lastName             String             @db.VarChar(100)
  email                String             @unique @db.VarChar(255)
  phone                String             @db.VarChar(20)
  volunteerTypeId      Int
  employeeTypeId       Int
  affiliationId        Int
  // หน่วยงาน = HealthcareFacility (ไม่เก็บชื่อซ้ำเป็น free-text)
  healthcareFacilityId String
  status               Boolean            @default(true)
  prefix               Prefix             @relation(fields: [prefixId], references: [id], onDelete: Restrict)
  volunteerType        VolunteerType      @relation(fields: [volunteerTypeId], references: [id], onDelete: Restrict)
  employeeType         EmployeeType       @relation(fields: [employeeTypeId], references: [id], onDelete: Restrict)
  affiliation          Affiliation        @relation(fields: [affiliationId], references: [id], onDelete: Restrict)
  healthcareFacility   HealthcareFacility @relation(fields: [healthcareFacilityId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  cases                Case[]

  @@index([prefixId])
  @@index([volunteerTypeId])
  @@index([employeeTypeId])
  @@index([affiliationId])
  @@index([healthcareFacilityId])
}

// สังกัด
model Affiliation {
  id            Int                  @id @default(autoincrement())
  name          String               @unique @db.VarChar(200)
  status        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  volunteers    Volunteer[]
  profileAdmins ProfileAdmin[]
  facilities    HealthcareFacility[]
}

model EmployeeType {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(100)
  status        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  volunteers    Volunteer[]
  profileAdmins ProfileAdmin[]
}

model VolunteerType {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(100)
  status     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  volunteers Volunteer[]
}

// Append-only audit — ไม่ FK ไป entity (log ต้องอยู่หลังลบตัวตน)
// Retention 90 วัน: ลบ/archive ที่แอป (job); ไม่ soft-delete แถว log
// diff/meta ห้ามใส่ password / token; PII (citizenId) mask ที่แอป
model AuditLog {
  id         String         @id @default(cuid())
  occurredAt DateTime       @default(now())

  actorType  AuditActorType
  actorId    String?        @db.VarChar(64)
  actorLabel String?        @db.VarChar(200)

  action     AuditAction
  entityType String         @db.VarChar(50)
  entityId   String?        @db.VarChar(64)

  caseId     String?        @db.VarChar(64)
  profileId  String?        @db.VarChar(64)
  facilityId String?        @db.VarChar(64)

  summary String  @db.VarChar(500)
  diff    Json?
  meta    Json?

  @@index([occurredAt])
  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([caseId, occurredAt])
  @@index([profileId, occurredAt])
  @@index([facilityId, occurredAt])
  @@index([action, occurredAt])
}
